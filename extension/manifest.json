{
  "manifest_version": 3,
  "name": "DinoPost AI - Trợ lý Đăng bài Reddit",
  "version": "1.2.0",
  "description": "Trợ lý AI tự động soạn thảo, tạo ảnh AI và đăng bài kèm media trên Reddit. Hỗ trợ Side Panel và chạy ngầm.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.reddit.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://image.pollinations.ai/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "DinoPost AI Reddit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
