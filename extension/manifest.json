{
  "manifest_version": 3,
  "name": "DinoPost AI - Trợ lý Đăng bài Reddit",
  "version": "1.3.0",
  "description": "MiniMax chat và soạn bài với kỹ năng, công cụ tạo ảnh riêng và chuẩn bị bản nháp Reddit trong Chrome đã đăng nhập.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://*.reddit.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://image.pollinations.ai/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "DinoPost AI Reddit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
