{
  "manifest_version": 3,
  "name": "DinoPost AI - Trợ lý Đăng bài Reddit",
  "version": "1.1.0",
  "description": "Trợ lý AI tự động soạn thảo, tạo ảnh AI và đăng bài kèm media trên Reddit.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.reddit.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://image.pollinations.ai/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DinoPost AI Reddit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
