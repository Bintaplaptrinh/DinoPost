{
  "name": "dinopost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "playwright test",
    "test:extension": "node --test tests/extension-runtime.unit.mjs && playwright test tests/extension.spec.ts",
    "test:extension:live": "node scripts/test-extension-live.mjs",
    "skills:sync": "node scripts/sync-extension-skills.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "format": "prettier --write src tests *.ts *.json *.md && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
